# Small original artifacts required to run the app after cloning
!data/processed/train.csv
!data/processed/test.csv
!models/best_model.joblib
!reports/metrics.json
!reports/model_comparison.csv

# Old notebook backups; keep the main educational notebook
notebooks/*_old.ipynb

# Keep empty project directories
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!reports/figures/.gitkeep
